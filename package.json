{
  "name": "oztest",
  "version": "0.0.1",
  "description": "DevOZ - Tech test",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.ts",
    "test": "mocha --require ts-node/register ./src/**/*.spec.ts --exit",
    "prepare": "husky install",
    "coverage": "nyc npm test",
    "lint": "npx eslint src/**/*.{ts,tsx,js,jsx}",
    "format": "prettier --write 'src/**/*.{ts,tsx,js,jsx,json}"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,js,jsx,json,css,md}": [
      "prettier --write"
    ]
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.10.0",
    "chai": "^5.2.0",
    "dotenv": "^17.0.1",
    "eslint": "^8.57.1",
    "express": "^4.18.2",
    "i18next": "^25.3.0",
    "i18next-fs-backend": "^2.6.0",
    "i18next-http-middleware": "^3.7.4",
    "mongoose": "^7.5.3",
    "sinon": "^21.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/chai": "^4.3.20",
    "@types/express": "^4.17.18",
    "@types/mocha": "^10.0.2",
    "@types/mongodb": "^4.0.6",
    "@types/node": "^20.8.0",
    "@types/sinon": "^17.0.4",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/yamljs": "^0.2.34",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "husky": "^9.1.7",
    "mocha": "^10.2.0",
    "mongodb-memory-server": "^10.1.4",
    "nodemon": "^3.0.1",
    "nyc": "^17.1.0",
    "openapi-types": "^12.1.3",
    "prettier": "^3.6.2",
    "supertest": "^7.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.35.1"
  }
}
